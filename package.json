    "prisma:studio": "prisma studio",
    "lint": "eslint src"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bullmq": "^5.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.11.0",
    "prisma": "^5.19.1"
  }
}
