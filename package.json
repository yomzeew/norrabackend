{
  "name": "norra-backend",
  "version": "0.2.0",
  "description": "Multi-tenant WhatsApp AI receptionist backend (Norra)",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
